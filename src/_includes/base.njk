<!DOCTYPE html>
<html lang="en" class="bg-[#1c1a17] scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Primary SEO Metadata -->
  <title>{{ title | default("Salafi Summaries — Authentic Book Notes") }}</title>
  <meta name="title" content="{{ title | default('Salafi Summaries') }}" />
  <meta name="description" content="{{ description | default('Concise summaries of authentic Islamic books upon the methodology of the Salaf.') }}" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://salafisummaries.netlify.app/{{ page.url }}" />

  <!-- Open Graph / Facebook / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://salafisummaries.netlify.app/{{ page.url }}" />
  <meta property="og:title" content="{{ title | default('Salafi Summaries') }}" />
  <meta property="og:description" content="{{ description | default('Concise summaries of authentic Islamic books upon the methodology of the Salaf.') }}" />
  <meta property="og:image" content="/public/og-image.jpg" />

  <!-- Twitter SEO -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="https://salafisummaries.netlify.app/{{ page.url }}" />
  <meta property="twitter:title" content="{{ title | default('Salafi Summaries') }}" />
  <meta property="twitter:description" content="{{ description | default('Concise summaries of authentic Islamic books upon the methodology of the Salaf.') }}" />
  <meta property="twitter:image" content="/public/og-image.jpg" />

  <!-- Favicon & PWA Icons -->
  <link rel="icon" type="image/x-icon" href="/public/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/public/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1c1a17" />

  <!-- Compiled Production CSS -->
  <link rel="stylesheet" href="/public/main.css" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Playfair+Display:ital,wght@1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;1,400&display=swap" rel="stylesheet">
</head>
<body class="bg-[#1c1a17] text-[#ede8df] font-sans-body antialiased min-h-screen selection:bg-[#d6b278]/30 selection:text-white">

  <!-- Main Content -->
  {{ content | safe }}

  <!-- PWA Registration -->
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then(reg => console.log('Service Worker registered.', reg))
          .catch(err => console.error('Service Worker registration failed:', err));
      });
    }
  </script>
</body>
</html>