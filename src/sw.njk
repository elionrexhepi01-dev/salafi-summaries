permalink: /sw.js
eleventyExcludeFromCollections: true
---
const CACHE_NAME = 'salafi-summaries-v9';

const STATIC_ASSETS = [
  '/',
  '/manifest.json',
  '/public/main.css',
  '/public/favicon.ico',
  '/public/hero-bg.jpg',
  {% for summary in collections.summaries %}
  '{{ summary.url }}'{% if not loop.last %},{% endif %}
  {% endfor %}
];

// Helper: Case-insensitive and slash-agnostic cache matcher
async function matchOfflineCache(requestUrl) {
  const cache = await caches.open(CACHE_NAME);
  const keys = await cache.keys();
  
  const targetPath = new URL(requestUrl).pathname.toLowerCase();
  const targetPathNoSlash = targetPath.endsWith('/') ? targetPath.slice(0, -1) : targetPath;

  for (const key of keys) {
    const keyPath = new URL(key.url).pathname.toLowerCase();
    const keyPathNoSlash = keyPath.endsWith('/') ? keyPath.slice(0, -1) : keyPath;

    if (keyPath === targetPath || keyPathNoSlash === targetPathNoSlash) {
      return await cache.match(key);
    }
  }
  return null;
}

// 1. Install Event
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      console.log('[PWA] Precaching assets...');
      await Promise.allSettled(
        STATIC_ASSETS.map(async (url) => {
          try {
            const res = await fetch(url);
            if (res.ok) {
              await cache.put(url, res);
              console.log(`[PWA Precached] ${url}`);
            } else {
              console.warn(`[PWA Precache HTTP Error ${res.status}] ${url}`);
            }
          } catch (err) {
            console.error(`[PWA Precache Failed] ${url}`, err);
          }
        })
      );
    })
  );
  self.skipWaiting();
});

// 2. Activate Event
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((keys) =>
      Promise.all(
        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))
      )
    ).then(() => self.clients.claim())
  );
});

// 3. Fetch Event
self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET') return;

  const url = new URL(request.url);
  if (url.origin !== location.origin) return;

  const isHTML = request.mode === 'navigate' || request.headers.get('accept')?.includes('text/html');

  if (isHTML) {
    event.respondWith(
      fetch(request)
        .then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        })
        .catch(async () => {
          console.log(`[PWA Offline Request] Navigating to: ${request.url}`);
          const cached = await matchOfflineCache(request.url);
          
          if (cached) {
            console.log(`[PWA Cache HIT] Served offline: ${request.url}`);
            return cached;
          }

          console.error(`[PWA Cache MISS] No cached file found for: ${request.url}`);
          return new Response(
            '<!DOCTYPE html><html><body style="background:#1c1a17;color:#ede8df;font-family:sans-serif;padding:2rem;">' +
            '<h1>Offline Page Not Found</h1>' +
            '<p>Requested path: <code>' + url.pathname + '</code></p>' +
            '<p>Check DevTools Console for details.</p>' +
            '<a href="/" style="color:#d6b278;">Back to Home</a></body></html>',
            { status: 503, headers: { 'Content-Type': 'text/html' } }
          );
        })
    );
  } else {
    event.respondWith(
      caches.match(request).then((cachedResponse) => {
        if (cachedResponse) return cachedResponse;
        return fetch(request).then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        });
      })
    );
  }
});