---
permalink: /sw.js
eleventyExcludeFromCollections: true
---
const CACHE_NAME = 'salafi-summaries-v10';

const STATIC_ASSETS = [
  '/',
  '/manifest.json',
  '/public/main.css',
  '/public/favicon.ico',
  '/public/hero-bg.jpg',
  {% for summary in collections.summaries %}
  {{ summary.url | dump | safe }}{% if not loop.last %},{% endif %}
  {% endfor %}
];

// Helper: Decode HTML entities & normalize URL paths
function normalizePath(urlStr) {
  try {
    const parsed = new URL(urlStr, location.origin);
    let path = decodeURIComponent(parsed.pathname).toLowerCase();
    if (path.length > 1 && path.endsWith('/')) {
      path = path.slice(0, -1);
    }
    return path;
  } catch (e) {
    return urlStr;
  }
}

// 1. Install Event — Pre-cache all summaries with clean unescaped URLs
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      console.log('[PWA] Starting precache...');
      await Promise.allSettled(
        STATIC_ASSETS.map(async (url) => {
          try {
            const res = await fetch(url);
            if (res.ok) {
              await cache.put(url, res);
              console.log(`[PWA Precached OK] ${url}`);
            } else {
              console.warn(`[PWA Precache HTTP ${res.status}] ${url}`);
            }
          } catch (err) {
            console.error(`[PWA Precache Failed] ${url}`, err);
          }
        })
      );
    })
  );
  self.skipWaiting();
});

// 2. Activate Event — Clean old caches
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((keys) =>
      Promise.all(
        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))
      )
    ).then(() => self.clients.claim())
  );
});

// 3. Fetch Event — Match offline URLs reliably
self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET') return;

  const url = new URL(request.url);
  if (url.origin !== location.origin) return;

  const isHTML = request.mode === 'navigate' || request.headers.get('accept')?.includes('text/html');

  if (isHTML) {
    event.respondWith(
      fetch(request)
        .then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        })
        .catch(async () => {
          const cache = await caches.open(CACHE_NAME);
          const targetPath = normalizePath(request.url);

          // Search cache keys matching normalized path
          const keys = await cache.keys();
          for (const key of keys) {
            if (normalizePath(key.url) === targetPath) {
              return await cache.match(key);
            }
          }

          return new Response(
            '<!DOCTYPE html><html><body style="background:#1c1a17;color:#ede8df;font-family:sans-serif;padding:2rem;">' +
            '<h1>Offline Page Not Saved</h1>' +
            '<p>The summary at <code>' + url.pathname + '</code> is not stored in offline cache.</p>' +
            '<a href="/" style="color:#d6b278;">Return Home</a></body></html>',
            { status: 503, headers: { 'Content-Type': 'text/html' } }
          );
        })
    );
  } else {
    event.respondWith(
      caches.match(request).then((cachedResponse) => {
        if (cachedResponse) return cachedResponse;
        return fetch(request).then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        });
      })
    );
  }
});