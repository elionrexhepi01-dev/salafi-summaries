---
permalink: /sw.js
eleventyExcludeFromCollections: true
---
const CACHE_NAME = 'salafi-summaries-v6';

const ASSETS_TO_CACHE = [
  '/',
  '/manifest.json',
  '/public/main.css',
  '/public/favicon.ico',
  {% for summary in collections.summaries %}
  '{{ summary.url }}'{% if not loop.last %},{% endif %}
  {% endfor %}
];

// 1. Install Event — Pre-cache all summaries cleanly
self.addEventListener('install', (e) => {
  e.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      await Promise.allSettled(
        ASSETS_TO_CACHE.map(async (url) => {
          try {
            await cache.add(url);
          } catch (err) {
            console.warn(`[PWA] Failed to precache: ${url}`, err);
          }
        })
      );
    })
  );
  self.skipWaiting();
});

// 2. Activate Event — Immediately take control and clear old caches
self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys().then((keys) => {
      return Promise.all(
        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))
      );
    })
  );
  self.clients.claim();
});

// 3. Fetch Event — Safe cache-first strategy
self.addEventListener('fetch', (e) => {
  if (e.request.method !== 'GET') return;

  const requestUrl = new URL(e.request.url);
  if (requestUrl.origin !== location.origin) return;

  e.respondWith(
    (async () => {
      // A. Check exact URL in cache
      const cachedResponse = await caches.match(e.request);
      if (cachedResponse) {
        return cachedResponse;
      }

      // B. Check trailing-slash variation (Eleventy clean URLs)
      const path = requestUrl.pathname;
      const normalizedPath = path.endsWith('/') ? path.slice(0, -1) : path + '/';
      const altCachedResponse = await caches.match(normalizedPath);
      if (altCachedResponse) {
        return altCachedResponse;
      }

      // C. Try fetching over the network
      try {
        const networkResponse = await fetch(e.request);

        // Asynchronously save to cache in the background (will not block or crash page load)
        if (networkResponse && networkResponse.status === 200 && networkResponse.type === 'basic') {
          const responseToCache = networkResponse.clone();
          caches.open(CACHE_NAME).then((cache) => {
            cache.put(e.request, responseToCache).catch((cacheErr) => {
              console.warn('[PWA] Background cache failed:', cacheErr);
            });
          });
        }

        return networkResponse;
      } catch (err) {
        console.error('[PWA] Network request failed:', e.request.url, err);

        // Always return a valid Response object so Chrome never shows ERR_FAILED
        return new Response(
          '<!DOCTYPE html><html><body style="background:#1c1a17;color:#ede8df;font-family:sans-serif;padding:2rem;">' +
          '<h1>Offline</h1><p>You are currently offline and this page was not previously saved.</p></body></html>',
          {
            status: 503,
            headers: { 'Content-Type': 'text/html' }
          }
        );
      }
    })()
  );
});