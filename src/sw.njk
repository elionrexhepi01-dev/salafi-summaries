---
permalink: /sw.js
eleventyExcludeFromCollections: true
---
const CACHE_NAME = 'salafi-summaries-v8';

const STATIC_ASSETS = [
  '/',
  '/manifest.json',
  '/public/main.css',
  '/public/favicon.ico',
  '/public/hero-bg.jpg',
  {% for summary in collections.summaries %}
  '{{ summary.url }}'{% if not loop.last %},{% endif %}
  {% endfor %}
];

// Helper: Smart cache lookup (handles trailing slashes & Netlify clean URLs)
async function matchInCache(request) {
  const cache = await caches.open(CACHE_NAME);
  
  // 1. Direct match
  let response = await cache.match(request);
  if (response) return response;

  const url = new URL(request.url);
  const path = url.pathname;

  // 2. Try alternate trailing slash (/path/ vs /path)
  const altPath = path.endsWith('/') ? path.slice(0, -1) : path + '/';
  response = await cache.match(altPath);
  if (response) return response;

  // 3. Scan cache keys by pathname comparison
  const keys = await cache.keys();
  for (const key of keys) {
    const keyUrl = new URL(key.url);
    if (keyUrl.pathname === path || keyUrl.pathname === altPath) {
      return await cache.match(key);
    }
  }

  return null;
}

// 1. Install Event — Pre-cache all summaries with dual-slash resolution
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      await Promise.allSettled(
        STATIC_ASSETS.map(async (url) => {
          try {
            const res = await fetch(url);
            if (res.ok) {
              await cache.put(url, res);
              // Also cache without trailing slash to guarantee hits
              if (url.length > 1 && url.endsWith('/')) {
                await cache.put(url.slice(0, -1), res.clone());
              }
            }
          } catch (err) {
            console.warn(`[PWA] Precache failed for: ${url}`, err);
          }
        })
      );
    })
  );
  self.skipWaiting();
});

// 2. Activate Event
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((keys) =>
      Promise.all(
        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))
      )
    ).then(() => self.clients.claim())
  );
});

// 3. Fetch Event
self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET') return;

  const url = new URL(request.url);
  if (url.origin !== location.origin) return;

  const isHTML = request.mode === 'navigate' || request.headers.get('accept')?.includes('text/html');

  if (isHTML) {
    event.respondWith(
      fetch(request)
        .then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        })
        .catch(async () => {
          // Offline lookup via smart match
          const cached = await matchInCache(request);
          if (cached) return cached;

          // Fallback message if specific summary wasn't stored
          return new Response(
            '<!DOCTYPE html><html><body style="background:#1c1a17;color:#ede8df;font-family:sans-serif;padding:2rem;">' +
            '<h1>Summary Not Offline</h1><p>This book summary was not found in cache.</p>' +
            '<a href="/" style="color:#d6b278;">Go to Homepage</a></body></html>',
            { status: 503, headers: { 'Content-Type': 'text/html' } }
          );
        })
    );
  } else {
    event.respondWith(
      caches.match(request).then((cachedResponse) => {
        if (cachedResponse) return cachedResponse;
        return fetch(request).then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        });
      })
    );
  }
});