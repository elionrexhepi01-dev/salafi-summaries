---
permalink: /sw.js
eleventyExcludeFromCollections: true
---
const CACHE_NAME = 'salafi-summaries-v11';

// 1. Raw asset list from Eleventy
const RAW_ASSETS = [
  '/',
  '/manifest.json',
  '/public/main.css',
  '/public/favicon.ico',
  '/public/hero-bg.jpg',
  {% for summary in collections.summaries %}
  {{ summary.url | dump | safe }}{% if not loop.last %},{% endif %}
  {% endfor %}
];

// 2. Pre-process assets to encode URLs cleanly (fixes ' and & issues)
const STATIC_ASSETS = [...new Set(RAW_ASSETS.flatMap(url => {
  if (!url) return [];
  const encoded = encodeURI(url);
  const decoded = decodeURI(url);
  return [url, encoded, decoded];
}))];

// Install Event
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(async (cache) => {
      console.log('[PWA] Precaching all summaries...');
      await Promise.allSettled(
        STATIC_ASSETS.map(async (url) => {
          try {
            const res = await fetch(url, { cache: 'reload' });
            if (res.ok) {
              await cache.put(url, res);
            }
          } catch (err) {
            console.warn('[PWA Precache Error]', url, err);
          }
        })
      );
    })
  );
  self.skipWaiting();
});

// Activate Event
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((keys) =>
      Promise.all(
        keys.filter((key) => key !== CACHE_NAME).map((key) => caches.delete(key))
      )
    ).then(() => self.clients.claim())
  );
});

// Fetch Event — Network First for HTML, falling back to cache
self.addEventListener('fetch', (event) => {
  const { request } = event;
  if (request.method !== 'GET') return;

  const url = new URL(request.url);
  if (url.origin !== location.origin) return;

  const isHTML = request.mode === 'navigate' || request.headers.get('accept')?.includes('text/html');

  if (isHTML) {
    event.respondWith(
      fetch(request)
        .then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        })
        .catch(async () => {
          // Attempt 1: Exact match
          let cached = await caches.match(request);
          if (cached) return cached;

          // Attempt 2: Decoded/Encoded URL match
          const decodedUrl = decodeURI(request.url);
          cached = await caches.match(decodedUrl);
          if (cached) return cached;

          // Attempt 3: Trailing slash match
          const path = url.pathname;
          const altPath = path.endsWith('/') ? path.slice(0, -1) : path + '/';
          cached = await caches.match(altPath);
          if (cached) return cached;

          // Fallback message if not cached
          return new Response(
            '<!DOCTYPE html><html><body style="background:#1c1a17;color:#ede8df;font-family:sans-serif;padding:2rem;">' +
            '<h1>Page Not Cached</h1><p>This summary is not available offline yet.</p>' +
            '<a href="/" style="color:#d6b278;">Return Home</a></body></html>',
            { status: 503, headers: { 'Content-Type': 'text/html' } }
          );
        })
    );
  } else {
    // Assets (CSS/Images)
    event.respondWith(
      caches.match(request).then((cachedResponse) => {
        if (cachedResponse) return cachedResponse;
        return fetch(request).then((networkResponse) => {
          if (networkResponse && networkResponse.status === 200) {
            const copy = networkResponse.clone();
            caches.open(CACHE_NAME).then((cache) => cache.put(request, copy));
          }
          return networkResponse;
        });
      })
    );
  }
});