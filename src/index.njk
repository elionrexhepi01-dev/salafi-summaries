---
layout: base.njk
title: Salafi Summaries
pagination:
  data: collections.summaries
  size: 12
  alias: summaries
permalink: "{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<!-- HERO SECTION -->
<section class="relative w-full h-screen flex flex-col justify-between items-center text-center px-4 py-8 overflow-hidden bg-[#1c1a17]">
  
  <!-- Hero Background Image -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img 
      id="hero-bg-img"
      src="/public/hero-bg.jpg" 
      alt="Bookshelf background" 
      class="object-cover w-full h-full transition-transform duration-100 ease-out scale-100 opacity-60 will-change-transform"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#1c1a17]/60 via-transparent to-[#1c1a17]"></div>
  </div>

  <!-- Eyebrow Tag -->
  <div class="relative z-10 pt-4 delay-100 hero-fade-in">
    <span class="text-xs sm:text-sm tracking-[0.35em] uppercase text-[#b3a898] font-medium select-none">
      SALAFI ASCRIPTION
    </span>
  </div>

  <!-- Hero Titles and Description -->
  <div class="relative z-10 flex flex-col items-center max-w-2xl gap-2 mx-auto my-auto">
    <h1 class="text-5xl italic font-normal tracking-tight text-white delay-200 sm:text-7xl md:text-8xl font-serif-title drop-shadow-md hero-fade-in">
      Salafi
    </h1>

    <p class="text-2xl sm:text-3xl md:text-4xl tracking-[0.25em] uppercase text-[#d6b278] font-medium mt-1 font-serif-sub drop-shadow hero-fade-in delay-300">
      SUMMARIES
    </p>

    <p class="text-sm sm:text-base md:text-lg text-[#ede8df] font-light max-w-xl mx-auto mt-6 leading-relaxed tracking-wide drop-shadow-sm hero-fade-in delay-400">
      Concise summaries of authentic Islamic books upon the methodology of the Salaf.
    </p>
  </div>

  <!-- Scroll Down Indicator -->
  <a 
    href="#summaries" 
    class="relative z-10 pb-4 flex flex-col items-center gap-1.5 opacity-0 hero-fade-in delay-500 cursor-pointer group"
  >
    <span class="text-[9px] tracking-[0.3em] uppercase text-[#b3a898] font-light select-none group-hover:text-[#ede8df] transition-colors">
      BEGIN YOUR JOURNEY
    </span>
    <svg class="w-4 h-4 text-[#b3a898] group-hover:text-[#d6b278] transition-colors animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

</section>

<!-- MAIN CONTENT / SUMMARIES GRID -->
<main id="summaries" class="max-w-5xl px-6 py-20 mx-auto sm:py-28">
  
  <!-- Section Title: SUMMARIES -->
  <div class="scroll-reveal mb-10 pb-4 border-b border-[#332e29]/60 flex flex-col items-start">
    <span class="text-xs tracking-[0.35em] uppercase text-[#d6b278] font-medium block mb-1">
      LIBRARY
    </span>
    <h2 class="text-3xl font-normal tracking-wide text-white sm:text-4xl font-serif-title">
      SUMMARIES
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 sm:gap-8">
    {% for summary in summaries %}
      <a 
        href="{{ summary.url }}" 
        class="scroll-reveal group block p-8 rounded-2xl bg-[#24211e]/80 hover:bg-[#2b2724] border border-[#332e29] hover:border-[#d6b278]/40 transition-all duration-300 hover:-translate-y-1.5 active:scale-[0.98] shadow-sm hover:shadow-xl hover:shadow-black/30"
      >
        <div class="flex flex-col justify-between h-full">
          <div>
            <h2 class="text-2xl sm:text-3xl font-serif-title font-normal text-white group-hover:text-[#d6b278] transition-colors duration-300">
              {{ summary.data.title }}
            </h2>
            <p class="text-xs text-[#d6b278]/80 mt-2 font-medium tracking-wider uppercase">
              By {{ summary.data.author }}
            </p>
            <p class="text-xs text-[#d6b278]/60 mt-2 font-light">
              Added {{ summary.data.dateAdded | date: "%B %d, %Y" }}
            </p>
            <p class="text-sm text-[#b3a898] mt-4 font-light leading-relaxed group-hover:text-[#ede8df] transition-colors duration-300 line-clamp-3">
              {{ summary.data.description }}
            </p>
          </div>
        </div>
      </a>
    {% else %}
      <div class="col-span-full text-center py-16 border border-dashed border-[#332e29] rounded-2xl text-[#b3a898] font-light text-sm">
        No summaries published yet.
      </div>
    {% endfor %}
  </div>
</main>

<!-- PAGINATION CONTROLS -->
  {% if pagination.pages.length > 1 %}
  <nav aria-label="Pagination Navigation" class="flex items-center justify-center gap-2 mt-12 pt-8 border-t border-[#332e29]/60">
    {# Previous Button #}
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}#summaries" class="inline-flex items-center px-3.5 py-2 rounded-xl bg-[#24211e] hover:bg-[#2d2a26] border border-[#332e29] hover:border-[#d6b278]/40 text-xs font-medium text-[#b3a898] hover:text-[#ede8df] transition-colors">
        &larr; Prev
      </a>
    {% else %}
      <span class="inline-flex items-center px-3.5 py-2 rounded-xl bg-[#1c1a17]/50 border border-[#332e29]/40 text-xs font-medium text-[#b3a898]/30 cursor-not-allowed">
        &larr; Prev
      </span>
    {% endif %}

    {# Page Number Links #}
    <div class="flex items-center gap-1 sm:gap-2">
      {% for pageEntry in pagination.pages %}
        {% set pageUrl = pagination.hrefs[loop.index0] %}
        {% if pageUrl == page.url %}
          <span aria-current="page" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#d6b278] text-[#1c1a17] text-xs font-semibold shadow-sm">
            {{ loop.index }}
          </span>
        {% else %}
          <a href="{{ pageUrl }}#summaries" class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#24211e] hover:bg-[#2d2a26] border border-[#332e29] hover:border-[#d6b278]/40 text-xs font-medium text-[#b3a898] hover:text-[#ede8df] transition-colors">
            {{ loop.index }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {# Next Button #}
    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}#summaries" class="inline-flex items-center px-3.5 py-2 rounded-xl bg-[#24211e] hover:bg-[#2d2a26] border border-[#332e29] hover:border-[#d6b278]/40 text-xs font-medium text-[#b3a898] hover:text-[#ede8df] transition-colors">
        Next &rarr;
      </a>
    {% else %}
      <span class="inline-flex items-center px-3.5 py-2 rounded-xl bg-[#1c1a17]/50 border border-[#332e29]/40 text-xs font-medium text-[#b3a898]/30 cursor-not-allowed">
        Next &rarr;
      </span>
    {% endif %}
  </nav>
  {% endif %}

