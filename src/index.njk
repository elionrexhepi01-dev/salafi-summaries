<script>
  // 1. Hero Image Scroll Zoom
  const heroImg = document.getElementById('hero-bg-img');
  window.addEventListener('scroll', () => {
    const scrollPosition = window.scrollY;
    if (scrollPosition < window.innerHeight) {
      const scaleValue = 1 + (scrollPosition / window.innerHeight) * 0.08;
      heroImg.style.transform = `scale(${scaleValue})`;
    }
  }, { passive: true });

  // 2. Intersection Observer for On-Scroll Grid Card Fade In
  const observerOptions = {
    root: null,
    rootMargin: '0px 0px -50px 0px',
    threshold: 0.15
  };

  const cardObserver = new IntersectionObserver((entries, observer) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('is-visible');
        }, (index % 2) * 150); 
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  document.querySelectorAll('.scroll-reveal').forEach(card => {
    cardObserver.observe(card);
  });
</script>